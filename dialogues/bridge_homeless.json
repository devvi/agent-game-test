            { "type": "slider_delta", "axis": "conviction", "delta": 0.5 }
          ]
        },
        {
          "text": "「我得走了。」",
          "next_node": "homeless_farewell",
          "effects": []
        }
      ]
    },
    "homeless_story": {
      "speaker": "Homeless Person",
      "text": "I made things too.\nSmall things. Paper boats.\nThen I just stopped—like infinite potential sealed in finite form.",
      "choices": [
        {
          "text": "「为什么？」",
          "next_node": "homeless_farewell",
          "effects": [
            { "type": "slider_delta", "axis": "conviction", "delta": 0.5 }
          ]
        },
        {
          "text": "「…我懂。」",
          "next_node": "homeless_farewell",
          "effects": [
            { "type": "slider_delta", "axis": "hope", "delta": 0.5 },
            { "type": "slider_delta", "axis": "will", "delta": 0.5 }
          ]
        },
        {
          "text": "「你为什么做游戏？」",
