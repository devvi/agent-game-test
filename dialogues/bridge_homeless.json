    },
    "homeless_deep_question": {
      "speaker": "Homeless Person",
      "text": "Why do you make games?\nAsk yourself that.\nThe infinite question meets a finite answer on this bridge.",
      "choices": [
        {
          "text": "「…也许吧。」",
