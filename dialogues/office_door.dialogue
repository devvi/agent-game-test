using StateSystem

~ door_greet
Narrator: The door is heavy.\nThe handle is cold.\nTonight feels different.
- Walk out. Don't look back.
	do StateSystem.apply_choice({"will": 0.5})
	do StateSystem.set_flag("office_exit_determined", true)
	=> door_leave
- Hesitate. One more look.
	do StateSystem.apply_choice({"conviction": -0.5})
	do StateSystem.set_flag("office_exit_sigh", true)
	=> door_hesitate
- Pause at the door. [if StateSystem.hope_despair >= 2]
	do StateSystem.set_flag("office_exit_neutral", true)
	=> door_lookback

~ door_lookback
Narrator: Blue light from the screen.\nYour mug sits empty.\nOne last glance back.
- Turn and go.
	do StateSystem.apply_choice({"will": 0.5})
	=> door_leave

~ door_hesitate
Narrator: The screensaver flickers.\nRain on the window.\nToo many nights like this one.
- Turn and go.
	do StateSystem.apply_choice({"will": 0.5})
	=> door_leave

~ door_leave
Narrator: The door clicks shut.\nThe hall stretches ahead.\nMaybe the night never ends.
- To the lobby.
	do StateSystem.set_flag("left_office", true)
	=> END
- Step out with purpose. [if StateSystem.hope_despair >= 4]
	do StateSystem.set_flag("left_office", true)
	do StateSystem.set_flag("left_with_purpose", true)
	=> END
- Each step takes work. [if StateSystem.hope_despair <= -4]
	do StateSystem.set_flag("left_office", true)
	=> END
