using StateSystem

~ npc_bartender_greet
Bartender: You again. Same as usual?
- Yeah, the usual.
	do StateSystem.apply_choice({"hope_despair": 0})
	=> npc_bartender_drink
- Not tonight. [if StateSystem.hope_despair <= 0]
	do StateSystem.set_flag("declined_drink", true)
	=> npc_bartender_leave
- ... [if StateSystem.hope_despair <= -4]
	do StateSystem.apply_choice({"hope_despair": -2})
	=> npc_bartender_silent

~ npc_bartender_drink
Bartender: One glass of warm sake, coming up.
- Thanks.
	do StateSystem.apply_choice({"hope_despair": 2})
	=> END

~ npc_bartender_leave
Bartender: Suit yourself.
- See you.
	=> END

~ npc_bartender_silent
Bartender: ... Right.
- ...
	=> END
