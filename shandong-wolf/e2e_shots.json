{
  "_comment": "shandong-wolf shot plan — stick-figure silhouette animation (#574). capture 场景 e2e_stick_figure_capture.tscn 被 e2e_capture.gd 轮询 /root/CaptureRig.current_state；auto_cycle 兜底（e2e_capture.gd press 不支持 digit 键，DESIGN §2.7 回退路径）：autoplay.tweaks 开启自循环，12 态依次停留，settle_frames 覆盖各动画时长。",
  "game": "shandong-wolf",
  "default_archetype": "loop",
  "main_scene": "res://scenes/e2e_stick_figure_capture.tscn",
  "max_wall_seconds": 120,
  "state_node": "/root/CaptureRig",
  "state_property": "current_state",
  "states": {
    "IDLE": 0,
    "MOVE": 1,
    "ATTACK_WINDUP": 2,
    "ATTACK_BURST": 3,
    "ATTACK_RECOVERY": 4,
    "GUARD": 5,
    "PARRY_SUCCESS": 6,
    "STAGGER": 7,
    "STANCE_BREAK": 8,
    "EXECUTE": 9,
    "REVIVE": 10,
    "DEAD": 11
  },
  "theme_color": "c0c8d0",
  "autoplay": {
    "mode": "capture",
    "tweaks": [
      { "node": "/root/CaptureRig", "prop": "auto_cycle", "value": true },
      { "node": "/root/CaptureRig", "prop": "auto_cycle_frames", "value": 30 }
    ]
  },
  "groups": {
    "stick_figure": {
      "_comment": "#574 火柴人剪影骨架与关键帧动画：12 态 shot（attack 三段独立 shot，settle_frames 匹配各自动画时长）。",
      "match": [
        "gdscripts/stick_figure.*\\.gd",
        "gdscripts/sword_arc\\.gd",
        "scenes/player_stick_figure.*\\.tscn"
      ],
      "shots": [
        { "name": "01_idle", "state": "IDLE", "settle_frames": 6 },
        { "name": "02_move", "state": "MOVE", "settle_frames": 6 },
        { "name": "03_attack_windup", "state": "ATTACK_WINDUP", "settle_frames": 5 },
        { "name": "04_attack_burst", "state": "ATTACK_BURST", "settle_frames": 1 },
        { "name": "05_attack_recovery", "state": "ATTACK_RECOVERY", "settle_frames": 4 },
        { "name": "06_guard", "state": "GUARD", "settle_frames": 6 },
        { "name": "07_parry_success", "state": "PARRY_SUCCESS", "settle_frames": 6 },
        { "name": "08_stagger", "state": "STAGGER", "settle_frames": 6 },
        { "name": "09_stance_break", "state": "STANCE_BREAK", "settle_frames": 6 },
        { "name": "10_execute", "state": "EXECUTE", "settle_frames": 2 },
        { "name": "11_revive", "state": "REVIVE", "settle_frames": 6 },
        { "name": "12_dead", "state": "DEAD", "settle_frames": 6 }
      ]
    },
    "hud": {
      "_comment": "#576 极简 HUD 观感裁决 4 帧（normal/low_hp/execute_hint/kill_hint）；驱动走 Hud 公有 debug API（set_debug_* / show_debug_hint），零战斗场景依赖；settle_frames 覆盖 Tween 淡入时长。",
      "main_scene": "res://scenes/e2e_hud_capture.tscn",
      "state_node": "/root/CaptureRig",
      "state_property": "current_state",
      "match": ["gdscripts/hud\\.gd", "gdscripts/e2e_hud_capture\\.gd", "scenes/e2e_hud_capture\\.tscn"],
      "shots": [
        { "name": "01_hud_normal", "state": 0, "settle_frames": 10 },
        { "name": "02_hud_low_hp", "state": 1, "settle_frames": 10 },
        { "name": "03_hud_execute_hint", "state": 2, "settle_frames": 10 },
        { "name": "04_hud_kill_hint", "state": 3, "settle_frames": 10 }
      ]
    }
  }
}
