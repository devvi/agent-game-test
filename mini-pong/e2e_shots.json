{
  "_comment": "mini-pong 专属 E2E shot plan（#358）。修正模板 state_node 为 /root/Game/...（Main.tscn 根节点名为 Game）。shot 级 deadline_s 缺省回退全局 max_wall_seconds（#372：03_gameover 单独 300s）。",
  "game": "mini-pong",
  "default_archetype": "loop",
  "max_wall_seconds": 120,
  "state_node": "/root/Game/GameStateMachine",
  "state_property": "current_state",
  "states": {
    "MENU": 0,
    "SERVING": 1,
    "PLAYING": 2,
    "PAUSED": 3,
    "SCORED": 4,
    "GAME_OVER": 5
  },
  "theme_color": "00e5ff",
  "autoplay": {
    "mode": "ai",
    "tweaks": [
      {
        "node": "/root/Game/PlayerPaddle",
        "prop": "mode",
        "value": 1
      },
      {
        "node": "/root/Game/AIPaddle",
        "prop": "mode",
        "value": 1
      },
      {
        "node": "/root/Game/AIPaddle",
        "prop": "ai_position_error",
        "value": 200
      }
    ]
  },
  "groups": {
    "loop": {
      "_comment": "match 覆盖 gdscripts/.*\\.gd、scenes/.*\\.tscn、project\\.godot —— 本 PR 改动必然命中，L3 视觉层会被执行",
      "match": [
        "gdscripts/.*\\.gd",
        "scenes/.*\\.tscn",
        "project\\.godot"
      ],
      "shots": [
        {
          "name": "01_title",
          "state": "MENU",
          "settle_frames": 10,
          "assert_text": [
            {
              "node": "/root/Game/StartMenu/VersionLabel",
              "prop": "text",
              "contains": "v1.0.0"
            }
          ]
        },
        {
          "name": "02_midgame",
          "state": "PLAYING",
          "press": {
            "key": "enter"
          },
          "require": [
            {
              "node": "/root/GameManager",
              "prop": "player_score",
              "min": 1
            },
            {
              "children_in_group": {
                "group": "bricks",
                "min": 4
              }
            }
          ],
          "settle_frames": 5,
          "visual": {
            "canvas": "720x1280",
            "bg_color": "0a0a12",
            "bg_min_dist": 24,
            "rain_bg_min_dist": 24,
            "regions": [
              {
                "name": "paddle",
                "x0": 0,
                "y0": 1220,
                "x1": 720,
                "y1": 1260,
                "min_nonbg_ratio": 0.05
              },
              {
                "name": "brick",
                "x0": 0,
                "y0": 560,
                "x1": 720,
                "y1": 720
              },
              {
                "name": "bg",
                "x0": 0,
                "y0": 0,
                "x1": 60,
                "y1": 60
              }
            ],
            "compare_pairs": [
              [
                "paddle",
                "brick"
              ],
              [
                "paddle",
                "bg"
              ],
              [
                "brick",
                "bg"
              ]
            ],
            "rgb_min_dist": 60,
            "rain": {
              "grid": 12,
              "min_coverage": 0.6,
              "_comment": "min_coverage 校准（DESIGN 466 Scenario F Test 14）自修正（#475 self-correct 2026-08-14）：0.15 回填基于漏水 bug 的实测 16.7% —— rain_curtain.tscn emission_shape=1(SPHERE)+emission_rect_extents(Godot 4.7 无此属性,静默忽略) 点源泄漏, 非真实雨分布。已修 BOX 发射(emission_shape=3+emission_box_extents) 后重新实测校准: 修复后真实覆盖应显著 >60%。"
            }
          }
        },
        {
          "name": "03_gameover",
          "state": "GAME_OVER",
          "settle_frames": 10,
          "deadline_s": 300
        }
      ]
    }
  }
}
