; Engine configuration file.
; Mini Pong — independent sub-project with Forward+ renderer and glow/bloom.

[application]
config/name="Mini Pong"
config/description="A classic Pong game implementation"
run/main_scene="res://scenes/Main.tscn"

[rendering]
renderer/rendering_method="forward_plus"
environment/glow_enabled=true
rendering/environment/defaults/default_clear_color=Color(0.039, 0.039, 0.071, 1)

[autoload]

GameManager="*res://gdscripts/game_manager.gd"
AudioEngine="*res://gdscripts/audio_engine.gd"
